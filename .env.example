PORT=3000
# Server-only secrets. Never put these in client code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_USER_LIMIT=10
AI_DAILY_GLOBAL_LIMIT=100
# Public Firebase web application configuration.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Server-only JSON service account, or use Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Protects manual/scheduled ingestion; use a random 32+ character value.
CRON_SECRET=
