# Replace the empty value with your OpenAI API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=3000

# Set true after filling the LRS settings below.
XAPI_ENABLED=false
# LRS xAPI base endpoint, e.g. https://lrs.example.com/xapi/
XAPI_LRS_URL=
# Basic authentication credentials (often called key and secret by an LRS).
XAPI_USERNAME=
XAPI_PASSWORD=
# Optional bearer token instead of username/password. Leave blank for Basic auth.
XAPI_AUTH_TOKEN=
# Stable public URL of this app, e.g. https://your-service.run.app/
XAPI_ACTIVITY_BASE_URL=
# A random secret of at least 32 characters; shared by all Cloud Run instances.
XAPI_SIGNING_SECRET=
